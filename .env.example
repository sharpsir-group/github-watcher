# GitHub Watcher Environment
# Copy to .env and fill in your values:  cp .env.example .env && chmod 600 .env

# --- Webhook Secrets (referenced by config.json "secret" field) ---
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_MY_APP=

# Matrix Stardom (intranet /stardom/)
WEBHOOK_SECRET_STARDOM=

# Data Model Studio / CDL inspector (intranet /cdl-studio/)
WEBHOOK_SECRET_CDL_STUDIO=

# Matrix Apps Template 2.1 (intranet /apps-template-2-1/)
WEBHOOK_SECRET_APPS_TEMPLATE_21=

# Matrix Apps Template 2.2 (intranet /apps-template-2-2/)
WEBHOOK_SECRET_APPS_TEMPLATE_22=

# Digital Employees / AI Agents (intranet /digital-employees/)
WEBHOOK_SECRET_DIGITAL_EMPLOYEES=

# MSA staging (intranet /msa-staging-main/ + /msa-staging-cdto/)
WEBHOOK_SECRET_MSA=

# Matrix Comms (intranet /comms/) — deploys from branch prod only
WEBHOOK_SECRET_COMMS=

# --- AWS (optional — CloudFront cache invalidation) ---
# IAM permissions: cloudfront:CreateInvalidation
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Cloudflare (optional — edge + Worker cache purge) ---
# Token permissions: Zone > Cache Purge > Purge
CF_API_TOKEN=
